---
// src/pages/countries/[slug].astro
// Statiske LAND-sider genereret fra avg-rent.json — SEO for "average rent in <land>"

// NB: getStaticPaths står FØR imports for at undgå Astro/Vite CJS-hoisting-fejl
export async function getStaticPaths() {
  return avgData.map(entry => ({
    params: { slug: entry.country.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') },
    props: { country: entry.country, cities: entry.cities },
  }));
}

import Layout from '../../layouts/Layout.astro';
import avgData from '../../../public/avg-rent.json';
import dstData from '../../data/dst-index.json';

function landSlug(c) { return c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
function bySlug(city, country) {
  return `${city.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${country.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}
const usd = n => '$' + Math.round(n).toLocaleString('en-US');
const week = n => Math.round(n * 12 / 52); // måned → uge

const { country, cities } = Astro.props;
const sorted = [...cities].sort((a, b) => (a.avg || 0) - (b.avg || 0));
const cheap = sorted[0], expensive = sorted[sorted.length - 1];
const avgAll = Math.round(sorted.reduce((s, c) => s + (c.avg || 0), 0) / sorted.length);
// Globalt gennemsnit på tværs af alle tracked byer (ekspat-sammenligning)
const _allCities = avgData.flatMap(e => (e.cities || []).map(c => c.avg || 0)).filter(Boolean);
const _globalAvg = Math.round(_allCities.reduce((s, v) => s + v, 0) / _allCities.length);
const _pct = Math.round(((avgAll - _globalAvg) / _globalAvg) * 100);

const title = `Average Rent in ${country} 2026: $${Math.round(avgAll)}/mo | RentMap`;
const description = `Average rent in ${country} 2026: from $${cheap.avg.toLocaleString('en-US')}/mo in ${cheap.city} to $${expensive.avg.toLocaleString('en-US')}/mo in ${expensive.city}. Updated daily from real rental listings on RentMap.`;
const pageUrl = `https://rentmap.net/countries/${Astro.params.slug}/`;
---

<Layout title={title} description={description} canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the average rent in ${country}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The average monthly rent in ${country} is $${avgAll.toLocaleString('en-US')}/month (≈${usd(week(avgAll))}/week), based on real listings across ${cities.length} cities.`
        }
      },
      {
        '@type': 'Question',
        name: `Which city in ${country} has the cheapest rent?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${cheap.city} has the most affordable average rent in ${country} at $${cheap.avg.toLocaleString('en-US')}/month.`
        }
      },
      {
        '@type': 'Question',
        name: `Is ${country} expensive to rent?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${country} has an average rent of $${avgAll.toLocaleString('en-US')}/month, which is ${avgAll > 2000 ? 'above' : avgAll > 1000 ? 'around' : 'below'} the global average. Rents vary significantly by city — from $${cheap.avg.toLocaleString('en-US')} in ${cheap.city} to $${expensive.avg.toLocaleString('en-US')} in ${expensive.city}.`
        }
      },
      {
        '@type': 'Question',
        name: `How much is rent in ${country} for expats?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `In our data, the average rent in ${country} is $${avgAll.toLocaleString('en-US')}/month — from $${cheap.avg.toLocaleString('en-US')}/month in ${cheap.city} to $${expensive.avg.toLocaleString('en-US')}/month in ${expensive.city}.`
        }
      },
      {
        '@type': 'Question',
        name: `How does ${country} compare to other countries when it comes to rent?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Across our tracked cities worldwide the average rent is $${_globalAvg.toLocaleString('en-US')}/month — ${country} is ${Math.abs(_pct)}% ${_pct > 0 ? 'above' : _pct < 0 ? 'below' : 'at'} that level.`
        }
      },
      {
        '@type': 'Question',
        name: `What do I need to rent an apartment in ${country}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Landlords typically require a passport or ID, proof of income (payslips or employment contract) and a deposit. Some ask for references or a guarantor — confirm the required documents before you view a place.`
        }
      }
    ]
  })}></script>
  <style>
    :global(body) { background:#0b1020; color:#e2e8f0; overflow:auto; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
    :global(.layout){ max-width:820px; margin:0 auto; padding:32px 20px 80px; }
    h1{ font-size:26px; font-weight:800; color:#fff; margin-bottom:6px; }
    .meta{ color:#94a3b8; font-size:14px; margin-bottom:24px; }
    .hero{ display:flex; gap:24px; align-items:center; margin:24px 0 32px; padding:18px 20px;
      border:1px solid rgba(255,255,255,0.1); border-radius:14px; background:rgba(255,255,255,0.04); }
    .hero .big{ font-size:30px; font-weight:800; color:#a78bfa; }
    .hero .week{ font-size:14px; color:#a3e635; font-weight:700; margin-left:10px; }
    .hero .lab{ font-size:12px; color:#94a3b8; text-transform:uppercase; letter-spacing:0.5px; }
    .dst{ margin:0 0 26px; padding:16px 18px; border:1px solid rgba(74,222,128,0.25);
      border-radius:14px; background:rgba(74,222,128,0.05); }
    .dst-title{ font-size:13px; color:#4ade80; font-weight:700; margin-bottom:12px; }
    .dst-row{ display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
    .dst-big{ font-size:24px; font-weight:800; color:#fff; }
    .dst-base{ font-size:12px; color:#94a3b8; font-weight:500; }
    .dst-sub{ font-size:11px; color:#94a3b8; }
    .dst-change{ text-align:right; }
    .dst-pct{ font-size:17px; font-weight:800; color:#4ade80; }
    .dst-pct-q{ color:#a3e635; }
    .dst-src{ margin-top:10px; font-size:11px; color:#64748b; }
    .dst-src a{ color:#4ade80; text-decoration:none; }
    .row{ display:flex; justify-content:space-between; gap:12px; padding:12px 4px;
      border-bottom:1px solid rgba(255,255,255,0.06); text-decoration:none; color:inherit; }
    .row:hover{ color:#a78bfa; }
    .row .name{ font-weight:600; }
    .row .price{ color:#94a3b8; font-size:13px; text-align:right; }
    .cta{ margin-top:32px; text-align:center; }
    .cta a{ display:inline-block; background:#7c3aed; color:#fff; padding:12px 22px; border-radius:12px;
      text-decoration:none; font-weight:700; }
    .others{ margin-top:28px; }
    .others h2{ font-size:15px; color:#94a3b8; font-weight:600; margin-bottom:8px; }
    .others a{ color:#a78bfa; text-decoration:none; font-size:13px; margin-right:10px; line-height:1.9; }
  </style>

  <div class="layout">
    <h1>Average Rent in {country}</h1>
    <div class="meta">2026 · {cities.length} cities · based on real listings on RentMap</div>

    <div class="hero">
      <div><div class="big">{usd(avgAll)}<span class="week">≈ {usd(week(avgAll))}/week</span></div><div class="lab">average monthly rent</div></div>
      <div style="flex:1"></div>
      <div style="text-align:right"><div class="big" style="color:#4ade80">{usd(cheap.avg)}</div><div class="lab">cheapest: {cheap.city}</div></div>
    </div>

    {country === 'Denmark' && dstData.all && (
      <div class="dst">
        <div class="dst-title">📈 Rent development — official statistics (Denmark)</div>
        <div class="dst-row">
          <div>
            <div class="dst-big">{dstData.all.index}<span class="dst-base"> (index 2015=100, {dstData.all.period})</span></div>
            <div class="dst-sub">Rent index for dwellings · whole country</div>
          </div>
          <div style="flex:1"></div>
          <div class="dst-change">
            <div class="dst-sub">Last year</div>
            <div class="dst-pct">+{(dstData.all.yoy * 100).toFixed(1)}%</div>
          </div>
          <div class="dst-change">
            <div class="dst-sub">Last quarter</div>
            <div class="dst-pct dst-pct-q">+{(dstData.all.qoq * 100).toFixed(1)}%</div>
          </div>
        </div>
        <div class="dst-src">Source: <a href={dstData.url} rel="nofollow">Statistikbanken · HUS1</a> — updated {dstData.updated}</div>
      </div>
    )}

    <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:24px;">
      <h2 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:16px;">Frequently Asked Questions</h2>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">What is the average rent in {country}?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">The average monthly rent in {country} is {usd(avgAll)}/month (≈{usd(week(avgAll))}/week), based on real listings across {cities.length} cities.</div>
      </div>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">Which city in {country} has the cheapest rent?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">{cheap.city} has the most affordable average rent in {country} at {usd(cheap.avg)}/month.</div>
      </div>
      <div>
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">Is {country} expensive to rent?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">{country} has an average rent of {usd(avgAll)}/month, which is {avgAll > 2000 ? 'above' : avgAll > 1000 ? 'around' : 'below'} the global average. Rents vary significantly by city — from {usd(cheap.avg)} in {cheap.city} to {usd(expensive.avg)} in {expensive.city}.</div>
      </div>
    </div>

    <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:24px;">
      <h2 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:16px;">Renting in {country} as an expat</h2>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">How much is rent in {country} for expats?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">In our data, the average rent in {country} is {usd(avgAll)}/month (≈{usd(week(avgAll))}/week) — from {usd(cheap.avg)}/month in {cheap.city} to {usd(expensive.avg)}/month in {expensive.city}. You can compare real listings on the globe and jump to any city's pricing page.</div>
      </div>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">How does {country} compare to other countries?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">Across our tracked cities worldwide the average rent is {usd(_globalAvg)}/month — {country} is <b style="color:#a3e635;">{Math.abs(_pct)}% {_pct > 0 ? 'above' : _pct < 0 ? 'below' : 'at'}</b> that level. Useful context when negotiating or budgeting.</div>
      </div>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">What do I need to rent an apartment in {country}?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">Landlords typically require a passport or ID, proof of income (payslips or employment contract) and a deposit. Some ask for references or a guarantor — confirm the required documents before you view a place.</div>
      </div>
      <div style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">Are utilities included in the rent?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">Often not — water, heating, electricity and internet are frequently billed separately after move-in. Always confirm with the landlord exactly what is included and what utilities typically cost per month.</div>
      </div>
      <div>
        <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">How much deposit do I need?</div>
        <div style="font-size:14px;color:#94a3b8;line-height:1.6;">A deposit of one to three months' rent is common in most countries, and the first month is usually paid upfront. Budget for this before you move so the paperwork is not a surprise.</div>
      </div>
    </div>

    <p style="color:#cbd5e1; line-height:1.6; margin-bottom:20px;">
      What does a rental home cost in {country} in 2026? {sorted.length > 1
        ? `In ${country}, the average monthly rent varies from {usd(cheap.avg)}/month in ${cheap.city} to {usd(expensive.avg)}/month in ${expensive.city}.`
        : `The average monthly rent in ${country} is {usd(avgAll)}/month.`}
      Below are the concrete prices per city — and you can zoom in on the globe itself to see real listings with address and a link to the original ad.
    </p>

    <div class="yours">
      {sorted.filter(c => c.avg).map(c => (
        <a href={`/rent-prices/${bySlug(c.city, country)}/`} class="row">
          <span class="name">{c.city}</span>
          <span class="price">{usd(c.avg)}/mo <span class="week-sub">≈ {usd(week(c.avg))}/wk</span> · 1-bed {usd(c.rent1)} · 2-bed {usd(c.rent2)}</span>
        </a>
      ))}
    </div>

    <div class="cta"><a href="/">See the listings on the globe 🌍</a></div>

    <div class="others">
      <h2>Other countries</h2>
      {avgData.filter(e => e.country !== country).slice(0, 30).map(e => (
        <a href={`/countries/${landSlug(e.country)}/`}>{e.country} · {usd(Math.round(e.cities.reduce((s, c) => s + (c.avg || 0), 0) / e.cities.length))}</a>
      ))}
    </div>
  </div>
</Layout>
