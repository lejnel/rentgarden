---
// src/pages/rent-prices/[slug].astro
// Statiske by-sider genereret fra avg-rent.json — SEO for "average rent in <by>"

// NB: getStaticPaths står FØR imports for at undgå Astro/Vite CJS-hoisting-fejl
export async function getStaticPaths() {
  const paths = [];
  const seen = new Set();
  for (const entry of avgData) {
    for (const city of entry.cities) {
      const slug = `${city.city.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${entry.country.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
      if (seen.has(slug)) continue;
      seen.add(slug);
      paths.push({ params: { slug }, props: { city, country: entry.country } });
    }
  }
  return paths;
}

import Layout from '../../layouts/Layout.astro';
import avgData from '../../../public/avg-rent.json';
import dstData from '../../data/dst-index.json';

const { city, country } = Astro.props;
const variants = avgData.find(entry => entry.country === country).cities.filter(c => c.city === city.city);
const { city: cityName, rent1, rent2, rent3, avg } = city;
const slugify = value => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const countryPath = `/countries/${slugify(country)}/`;
const usd = value => '$' + value.toLocaleString('en-US');
const otherCities = avgData.flatMap(entry => entry.cities.map(c => ({ ...c, country: entry.country })))
  .filter(c => c.city !== cityName || c.country !== country)
  .sort((a, b) => Number(b.country === country) - Number(a.country === country))
  .slice(0, 9);
const week = n => Math.round(n * 12 / 52); // måned → uge

const title = `Rent snapshot for ${cityName}, ${country}: Average $${avg.toLocaleString('en-US')}/mo | RentMap`;
const description = `Stored rent reference for ${cityName}, ${country}: average rent is $${avg.toLocaleString('en-US')}/mo (≈$${week(avg).toLocaleString('en-US')}/wk). 1-bed $${rent1.toLocaleString('en-US')} · 2-bed $${rent2.toLocaleString('en-US')} · 3-bed $${rent3.toLocaleString('en-US')}. Stored USD snapshot; observation dates are unavailable.`;
const pageUrl = `https://rentmap.net/rent-prices/${Astro.params.slug}/`;

// DST-huslejeindeks for danske byer (region-niveau, officiel statistik)
const DK_REGION = { aalborg: '081', aarhus: '082' };
const dstEntry = country === 'Denmark'
  ? (dstData.regions[DK_REGION[cityName.toLowerCase()]] || dstData.all)
  : null;
---

<Layout title={title} description={description} canonical={pageUrl} noindex={true} pageType="city">
  <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      url: pageUrl,
      description,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'RentMap', item: 'https://rentmap.net/' },
          { '@type': 'ListItem', position: 2, name: `Rent in ${country}`, item: `https://rentmap.net${countryPath}` },
          { '@type': 'ListItem', position: 3, name: cityName }
        ]
      }
    })}></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the average rent in ${cityName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The stored combined monthly reference for ${cityName}, ${country} is $${avg.toLocaleString('en-US')}/month (≈$${week(avg).toLocaleString('en-US')}/week).`
        }
      },
      {
        '@type': 'Question',
        name: `How much is a 1-bedroom apartment in ${cityName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `A 1-bedroom apartment in ${cityName} has a stored reference of $${rent1.toLocaleString('en-US')}/month ($${week(rent1).toLocaleString('en-US')}/week).`
        }
      },
      {
        '@type': 'Question',
        name: `What should I keep in mind when comparing rents?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'These averages are a starting point for your search. The neighbourhood, property size, condition, and included bills can all affect the price. Check the original listing for the full costs and terms.'
        }
      }
    ]
  })}></script>

  <main id="main-content" class="city-page">
    <header class="topbar">
      <a class="brand" href="/" aria-label="RentMap home"><span class="brand-mark" aria-hidden="true">⌂</span> RentMap</a>
      <a class="back-link" href="/map/">Explore the globe <span aria-hidden="true">↗</span></a>
    </header>
    <div class="page-content">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href={countryPath}>{country}</a><span aria-hidden="true">/</span><span aria-current="page">{cityName}</span>
      </nav>
      <section class="intro" aria-labelledby="city-title">
        <p class="eyebrow">A place to call home</p>
        <h1 id="city-title">Rent prices in <span>{cityName}</span></h1>
        <p class="intro-copy">Get a feel for renting in {cityName}, {country}. Compare home sizes and find a starting point for your budget.</p>
        <p class="currency-note">Stored prices in US dollars · Observation dates unavailable</p>
      </section>

      {variants.length > 1 && <section class="panel"><h2>Multiple records need verification</h2><p class="analysis-copy">The import contains {variants.length} different records for {cityName} without dates or district labels. The headline below shows the first imported record, not a resolved city average. Do not treat these conflicting values as a current quote.</p><ul>{variants.map((v,i) => <li>Record {i+1}: 1 bedroom {usd(v.rent1)}, 2 bedrooms {usd(v.rent2)}, 3 bedrooms {usd(v.rent3)} per month.</li>)}</ul></section>}
      <section class="rent-panel" aria-labelledby="average-title">
        <div class="average">
          <div>
            <h2 id="average-title">Combined monthly reference</h2>
            <p class="headline-price">{usd(avg)}<span> / month</span></p>
            <p class="weekly">Approximately {usd(week(avg))} per week</p>
          </div>
          <span class="location-pill">{cityName}, {country}</span>
        </div>
        <div class="bedroom-grid">
          {[rent1, rent2, rent3].map((rent, index) => (
            <article class="bedroom-card">
              <h3><span class="room-icon" aria-hidden="true">⌂</span> {index + 1} bedroom{index > 0 ? 's' : ''}</h3>
              <p class="room-price">{usd(rent)}<span> / month</span></p>
              <p>≈ {usd(week(rent))} per week</p>
            </article>
          ))}
        </div>
        <p class="source-note">Stored snapshot attributed to GlobalPropertyGuide; source observation and exchange-rate dates were not recorded. Actual rents vary by location and property. <a href="/about/">About the data →</a></p>
      </section>

      {dstEntry && (
        <section class="panel trends" aria-labelledby="trends-title">
          <p class="eyebrow">Official statistics · Denmark</p>
          <h2 id="trends-title">How rents are changing</h2>
          <div class="trend-grid">
            <div><span>Rent index · {dstEntry.period}</span><strong>{dstEntry.index}</strong><small>{dstEntry.label} · 2015 = 100</small></div>
            <div><span>Over the last year</span><strong>{dstEntry.yoy >= 0 ? '+' : ''}{(dstEntry.yoy * 100).toFixed(1)}%</strong></div>
            <div><span>Over the last quarter</span><strong>{dstEntry.qoq >= 0 ? '+' : ''}{(dstEntry.qoq * 100).toFixed(1)}%</strong></div>
          </div>
          <p class="source-note">Source: <a href={dstData.url} rel="nofollow">Statistikbanken · HUS1</a> · Updated {dstData.updated}</p>
        </section>
      )}

      <section class="panel" aria-labelledby="comparison-title"><p class="eyebrow">Compare home sizes</p><h2 id="comparison-title">What changes with an extra bedroom?</h2>
        <p class="analysis-copy">The two-bedroom reference is {usd(Math.abs(rent2-rent1))} {rent2 >= rent1 ? 'higher' : 'lower'} per month than the one-bedroom figure in {cityName}. Over twelve months, that difference is {usd(Math.abs(rent2-rent1)*12)} before utilities or other charges.</p>
        <p class="analysis-copy">If two people split the two-bedroom rent equally, the rent-only share would be {usd(Math.round(rent2/2))} per person per month. This is an illustrative split of the stored figure, not an available room offer, and excludes bills.</p>
        {(rent2 < rent1 || rent3 < rent2) && <p class="analysis-copy">Data caution: a larger bedroom category is cheaper than a smaller one in this record. The source samples are unavailable, so we cannot establish why. Verify the figures against current comparable listings.</p>}
        <p class="analysis-copy">The combined figure gives the bedroom categories equal weight. It is not a measured average of all homes in {cityName}. The stored import lacks observation dates and sample sizes. <a href="/about/">Read the methodology</a> and <a href="/rent-budget/">calculate a budget using a current listing</a>.</p>
      </section>

      <section class="explore-panel" aria-labelledby="explore-title">
        <div><p class="eyebrow">From averages to actual homes</p><h2 id="explore-title">See what’s out there</h2><p>Explore rental listings on the globe, compare prices, and open the original ads for more details.</p></div>
        <a class="button" href="/map/">Explore rental listings <span aria-hidden="true">↗</span></a>
      </section>

      <section class="panel faq" aria-labelledby="faq-title">
        <p class="eyebrow">A little more local knowledge</p>
        <h2 id="faq-title">Your renting questions, answered</h2>
        <details open><summary>What is the average rent in {cityName}?</summary><p>The stored combined monthly reference for {cityName}, {country} is {usd(avg)} per month (approximately {usd(week(avg))} per week).</p></details>
        <details><summary>How much is a 1-bedroom apartment in {cityName}?</summary><p>A 1-bedroom apartment in {cityName} has a stored reference of {usd(rent1)} per month (approximately {usd(week(rent1))} per week).</p></details>
        <details><summary>What should I keep in mind when comparing rents?</summary><p>These averages are a starting point for your search. The neighbourhood, property size, condition, and included bills can all affect the price. Check the original listing for the full costs and terms.</p></details>
      </section>

      <section class="other-cities" aria-labelledby="cities-title">
        <div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2 id="cities-title">Explore more cities</h2></div><a href={countryPath}>More in {country} →</a></div>
        <div class="city-grid">
          {otherCities.map(c => <a class="city-card" href={`/rent-prices/${slugify(c.city)}-${slugify(c.country)}/`}><div><h3>{c.city}</h3><span>{c.country}</span></div><div class="city-price">{usd(c.avg)}<small>/ month →</small></div></a>)}
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  *, *::before, *::after { box-sizing:border-box; }
  h1,h2,h3,p { margin:0; }
  .city-page { --ink:#223d37; --muted:#5f706b; --green:#25634f; color:var(--ink); background:#f8faf7; line-height:1.6; }
  a { color:var(--green); text-decoration:none; }
  a:hover { text-decoration:underline; }
  a:focus-visible, summary:focus-visible { outline:3px solid #277660; outline-offset:5px; border-radius:4px; }
  .topbar { max-width:1120px; margin:auto; padding:22px 32px; display:flex; align-items:center; justify-content:space-between; gap:20px; border-bottom:1px solid #dfe7e1; }
  .brand { display:flex; align-items:center; gap:9px; font-size:21px; font-weight:750; letter-spacing:-.6px; }
  .brand-mark { background:#e4efe5; border-radius:12px; width:36px; height:36px; display:grid; place-items:center; font-size:25px; }
  .back-link { font-size:14px; font-weight:600; }
  .page-content { max-width:1040px; margin:auto; padding:28px 32px 64px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:10px; font-size:13px; color:var(--muted); }
  .intro { padding:40px 0 30px; max-width:740px; }
  .eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:1.6px; font-weight:750; color:var(--green); margin-bottom:10px; }
  h1 { font-size:clamp(32px,5vw,52px); line-height:1.12; letter-spacing:-1.8px; font-weight:750; margin-bottom:18px; }
  h1 span { color:var(--green); }
  .intro-copy { color:var(--muted); font-size:17px; max-width:620px; }
  .currency-note { margin-top:18px; font-size:12px; color:var(--muted); }
  .rent-panel,.panel { background:#fff; border:1px solid #dde6df; border-radius:22px; padding:30px; margin-bottom:24px; }
  .rent-panel { box-shadow:0 8px 32px #28463806; }
  .average { display:flex; align-items:center; justify-content:space-between; gap:20px; padding-bottom:26px; }
  .average h2 { font-size:15px; font-weight:500; color:var(--muted); }
  .headline-price { font-size:clamp(36px,5vw,48px); font-weight:750; letter-spacing:-1.6px; line-height:1.4; }
  .headline-price span,.room-price span { font-size:13px; color:var(--muted); font-weight:400; letter-spacing:0; white-space:nowrap; }
  .weekly { color:var(--muted); font-size:14px; }
  .location-pill { background:#edf4eb; color:#416348; padding:7px 13px; border-radius:30px; font-size:12px; text-align:center; }
  .bedroom-grid,.trend-grid,.city-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  .bedroom-card { background:#f6f8f4; border:1px solid #e7ece3; border-radius:14px; padding:20px; }
  .bedroom-card h3 { font-size:14px; font-weight:600; margin-bottom:16px; }
  .room-icon { color:var(--green); font-size:20px; margin-right:5px; }
  .room-price { font-size:25px; font-weight:700; letter-spacing:-.6px; }
  .bedroom-card > p:last-child { color:var(--muted); font-size:12px; margin-top:3px; }
  .source-note { color:var(--muted); font-size:12px; margin-top:22px; }
  .source-note a { text-decoration:underline; }
  h2 { font-size:23px; line-height:1.3; letter-spacing:-.5px; }
  .trend-grid { margin-top:24px; }
  .trend-grid span,.trend-grid small { display:block; font-size:12px; color:var(--muted); }
  .trend-grid strong { display:block; font-size:28px; margin:4px 0; }
  .explore-panel { background:#eaf2e9; border:1px solid #dae6d9; border-radius:22px; padding:30px; display:flex; align-items:center; gap:32px; justify-content:space-between; margin-bottom:24px; }
  .explore-panel p:last-child { max-width:530px; font-size:14px; color:var(--muted); margin-top:12px; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:16px; background:var(--green); color:#fff; padding:13px 20px; border-radius:10px; font-size:14px; font-weight:600; flex-shrink:0; }
  .button:hover { background:#194c3c; text-decoration:none; }
  .analysis-copy { margin-top:14px; font-size:14px; color:var(--muted); }
  .faq h2 { margin-bottom:20px; }
  details { border-top:1px solid #e4eae4; padding:18px 0; }
  details:last-child { padding-bottom:0; }
  summary { cursor:pointer; font-size:15px; font-weight:600; padding-right:10px; }
  details p { color:var(--muted); font-size:14px; margin-top:12px; max-width:720px; }
  .other-cities { margin-top:42px; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:20px; }
  .section-heading > a { font-size:13px; }
  .city-card { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px; background:#fff; border:1px solid #dde6df; border-radius:12px; }
  .city-card:hover { background:#edf4eb; border-color:#a3bcaa; text-decoration:none; }
  .city-card h3 { font-size:14px; color:var(--ink); }
  .city-card span,.city-card small { display:block; font-size:11px; color:var(--muted); }
  .city-price { text-align:right; font-size:15px; font-weight:650; white-space:nowrap; }
  @media(max-width:760px) { .city-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .explore-panel { flex-direction:column; align-items:flex-start; gap:20px; } .bedroom-card { padding:14px; } .room-price span { display:block; } }
  @media(max-width:520px) { .topbar { padding:18px 20px; } .page-content { padding:22px 20px 40px; } .intro { padding-top:28px; } .rent-panel,.panel,.explore-panel { padding:22px; border-radius:16px; } .average { align-items:flex-start; flex-direction:column; gap:12px; } .bedroom-grid,.city-grid { grid-template-columns:1fr; } .bedroom-card { display:grid; grid-template-columns:1fr auto; align-items:center; gap:0 10px; } .bedroom-card h3 { margin:0; } .bedroom-card > p:last-child { grid-column:2; } .room-price { text-align:right; font-size:23px; } .room-price span { display:inline; } .trend-grid { grid-template-columns:1fr 1fr; } .trend-grid > div:first-child { grid-column:1/-1; } .section-heading { align-items:flex-start; flex-direction:column; gap:12px; } .button { width:100%; } h2 { font-size:21px; } }
</style>
