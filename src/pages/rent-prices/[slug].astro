---
// src/pages/rent-prices/[slug].astro
// Statiske by-sider genereret fra avg-rent.json — SEO for "average rent in <by>"

// NB: getStaticPaths står FØR imports for at undgå Astro/Vite CJS-hoisting-fejl
export async function getStaticPaths() {
  const paths = [];
  for (const entry of avgData) {
    for (const city of entry.cities) {
      const slug = `${city.city.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${entry.country.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
      paths.push({ params: { slug }, props: { city, country: entry.country } });
    }
  }
  return paths;
}

import Layout from '../../layouts/Layout.astro';
import avgData from '../../../public/avg-rent.json';
import dstData from '../../data/dst-index.json';

const { city, country } = Astro.props;
const { city: cityName, lat, lng, rent1, rent2, rent3, avg } = city;
const week = n => Math.round(n * 12 / 52); // måned → uge

const title = `Average Rent in ${cityName} 2026: $${avg.toLocaleString('en-US')}/mo | RentMap`;
const description = `Average rent in ${cityName}, ${country} 2026: $${avg.toLocaleString('en-US')}/mo (≈$${week(avg).toLocaleString('en-US')}/wk). 1-bed $${rent1.toLocaleString('en-US')} · 2-bed $${rent2.toLocaleString('en-US')} · 3-bed $${rent3.toLocaleString('en-US')}. Updated daily from real rental listings.`;
const pageUrl = `https://rentmap.net/rent-prices/${Astro.params.slug}/`;

// DST-huslejeindeks for danske byer (region-niveau, officiel statistik)
const DK_REGION = { aalborg: '081', aarhus: '082' };
const dstEntry = country === 'Denmark'
  ? (dstData.regions[DK_REGION[cityName.toLowerCase()]] || dstData.all)
  : null;
---

<Layout title={title} description={description} canonical={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      url: pageUrl,
      description,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'RentMap', item: 'https://rentmap.net/' },
          { '@type': 'ListItem', position: 2, name: `Rent in ${country}`, item: 'https://rentmap.net/' },
          { '@type': 'ListItem', position: 3, name: cityName }
        ]
      }
    })}></script>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `What is the average rent in ${cityName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The average monthly rent in ${cityName}, ${country} is $${avg.toLocaleString('en-US')}/month (≈$${week(avg).toLocaleString('en-US')}/week).`
        }
      },
      {
        '@type': 'Question',
        name: `How much is a 1-bedroom apartment in ${cityName}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `A 1-bedroom apartment in ${cityName} costs an average of $${rent1.toLocaleString('en-US')}/month ($${week(rent1).toLocaleString('en-US')}/week).`
        }
      },
      {
        '@type': 'Question',
        name: `Is ${cityName} expensive to rent?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${cityName} has an average rent of $${avg.toLocaleString('en-US')}/month, which is ${avg > 2000 ? 'above' : avg > 1000 ? 'around' : 'below'} the global average. Compared to ${country}'s capital, rents here are typically ${avg < 1500 ? 'more affordable' : 'competitive'}.`
        }
      }
    ]
  })}></script>

  <main style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0a0e17;color:#e2e8f0;min-height:100vh;padding:40px 20px;overflow-y:auto;">
    <div style="max-width:720px;margin:0 auto;">
      <a href="/" style="color:#6366f1;text-decoration:none;font-size:14px;">← Back to the RentMap globe</a>
      
      <h1 style="font-size:32px;font-weight:800;margin:20px 0 8px;color:#fff;">Average Rent in {cityName}, {country}</h1>
      <p style="color:#8899b4;font-size:15px;margin-bottom:28px;">Updated {new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} · Source: GlobalPropertyGuide + real listings</p>

      <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:24px;">
        <div style="font-size:14px;color:#8899b4;margin-bottom:4px;">Average monthly rent</div>
        <div style="font-size:40px;font-weight:800;color:#22c55e;">${avg.toLocaleString('en-US')}<span style="font-size:18px;color:#8899b4;">/mo</span> <span style="font-size:22px;color:#a3e635;font-weight:700;">≈ ${week(avg).toLocaleString('en-US')}<span style="font-size:14px;">/week</span></span></div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px;">
          <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:14px;text-align:center;">
            <div style="font-size:20px;font-weight:700;color:#fff;">${rent1.toLocaleString('en-US')}</div>
            <div style="font-size:12px;color:#8899b4;">1-bedroom /mo</div>
            <div style="font-size:12px;color:#a3e635;">≈ ${week(rent1).toLocaleString('en-US')}/wk</div>
          </div>
          <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:14px;text-align:center;">
            <div style="font-size:20px;font-weight:700;color:#fff;">${rent2.toLocaleString('en-US')}</div>
            <div style="font-size:12px;color:#8899b4;">2-bedroom /mo</div>
            <div style="font-size:12px;color:#a3e635;">≈ ${week(rent2).toLocaleString('en-US')}/wk</div>
          </div>
          <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:14px;text-align:center;">
            <div style="font-size:20px;font-weight:700;color:#fff;">${rent3.toLocaleString('en-US')}</div>
            <div style="font-size:12px;color:#8899b4;">3-bedroom /mo</div>
            <div style="font-size:12px;color:#a3e635;">≈ ${week(rent3).toLocaleString('en-US')}/wk</div>
          </div>
        </div>
      </div>

      {dstEntry && (
        <div style="background:rgba(74,222,128,0.05);border:1px solid rgba(74,222,128,0.25);border-radius:16px;padding:20px;margin-bottom:24px;">
          <div style="font-size:13px;color:#4ade80;font-weight:700;margin-bottom:10px;">📈 Rent development — official statistics (Denmark)</div>
          <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;">
            <div>
              <div style="font-size:28px;font-weight:800;color:#fff;">{dstEntry.index}<span style="font-size:13px;color:#94a3b8;font-weight:500;"> (index 2015=100, {dstEntry.period})</span></div>
              <div style="font-size:12px;color:#94a3b8;">{dstEntry.label} · rent index for dwellings</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:12px;color:#94a3b8;">Last year</div>
              <div style="font-size:18px;font-weight:800;color:#4ade80;">+{(dstEntry.yoy * 100).toFixed(1)}%</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:12px;color:#94a3b8;">Last quarter</div>
              <div style="font-size:18px;font-weight:800;color:#a3e635;">+{(dstEntry.qoq * 100).toFixed(1)}%</div>
            </div>
          </div>
          <div style="margin-top:10px;font-size:11px;color:#64748b;">Source: <a href={dstData.url} style="color:#4ade80;text-decoration:none;" rel="nofollow">Statistikbanken · HUS1</a> — updated {dstData.updated}</div>
        </div>
      )}

      <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:24px;">
        <h2 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:16px;">Frequently Asked Questions</h2>
        <div style="margin-bottom:16px;">
          <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">What is the average rent in {cityName}?</div>
          <div style="font-size:14px;color:#94a3b8;line-height:1.6;">The average monthly rent in {cityName}, {country} is ${avg.toLocaleString('en-US')}/month (≈${week(avg).toLocaleString('en-US')}/week).</div>
        </div>
        <div style="margin-bottom:16px;">
          <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">How much is a 1-bedroom apartment in {cityName}?</div>
          <div style="font-size:14px;color:#94a3b8;line-height:1.6;">A 1-bedroom apartment in {cityName} costs an average of ${rent1.toLocaleString('en-US')}/month (${week(rent1).toLocaleString('en-US')}/week).</div>
        </div>
        <div>
          <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:8px;">Is {cityName} expensive to rent?</div>
          <div style="font-size:14px;color:#94a3b8;line-height:1.6;">{cityName} has an average rent of ${avg.toLocaleString('en-US')}/month, which is {avg > 2000 ? 'above' : avg > 1000 ? 'around' : 'below'} the global average. Compared to {country}'s capital, rents here are typically {avg < 1500 ? 'more affordable' : 'competitive'}.</div>
        </div>
      </div>

      <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;margin-bottom:24px;">
        <h2 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:12px;">Real rental listings in {cityName}</h2>
        <p style="color:#8899b4;font-size:14px;line-height:1.6;">RentMap collects real apartment, house and room listings from local portals across the world. Each dot on the globe is an actual listing with price, address and a link to the original ad. Explore {cityName} and compare what people actually pay — not estimates.</p>
        <a href="/" style="display:inline-block;margin-top:14px;background:#6366f1;color:#fff;padding:10px 18px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600;">Explore {cityName} on the globe →</a>
      </div>

      <h2 style="font-size:18px;font-weight:700;color:#fff;margin-bottom:12px;">Other cities</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;">
        {
          avgData.slice(0, 24).map(entry =>
            entry.cities.slice(0, 2).map(c => {
              const s = `${c.city.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${entry.country.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
              return <a href={`/rent-prices/${s}/`} style="color:#8899b4;text-decoration:none;font-size:13px;padding:8px;border-radius:8px;background:rgba(255,255,255,0.03);"> {c.city}, {entry.country}</a>;
            })
          )
        }
      </div>

      <p style="color:#64748b;font-size:12px;margin-top:32px;">RentMap — real rental prices on an interactive 3D globe. Data: GlobalPropertyGuide (average rents) and local listing portals.</p>
    </div>
  </main>
</Layout>
