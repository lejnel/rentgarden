---
// Minimal test-side med getStaticPaths (samme mønster som [slug]-siderne)
import avgData from '../../public/avg-rent.json';
export function getStaticPaths() {
  return [{ params: { slug: 'test' } }];
}
const { slug } = Astro.params;
const cnt = Array.isArray(avgData) ? avgData.length : -1;
---
<html><body><h1>TEST {slug}</h1><p>avgData count: {cnt}</p></body></html>