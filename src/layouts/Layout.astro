---
// src/layouts/Layout.astro
const title = 'RentMap — Global Rent Prices on an Interactive Globe';
const description = 'Explore real rental prices around the world on an interactive 3D globe. See what people actually pay for apartments, houses and rooms — from Copenhagen to New York, Shanghai and Mumbai.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href="https://rentmap.net/">
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RentMap">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content="https://rentmap.net/">
  <meta property="og:image" content="https://rentmap.net/favicon.svg">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <!-- Geo meta (site is global) -->
  <meta name="geo.region" content="DK">
  <meta name="geo.placename" content="Copenhagen">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Structured data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "RentMap",
    "url": "https://rentmap.net/",
    "description": {description},
    "inLanguage": "en"
  }
  </script>
  
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #000;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }
  </style>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
