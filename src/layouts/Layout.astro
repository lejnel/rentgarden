---
// src/layouts/Layout.astro
const { title = 'RentMap — Global Rent Prices on an Interactive Globe', description = 'Real rental prices on an interactive 3D globe. Explore what people actually pay for apartments, houses and rooms worldwide.', canonical = 'https://rentmap.net/' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RentMap">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content="https://rentmap.net/favicon.svg">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <!-- Geo meta (site is global) -->
  <meta name="geo.region" content="Worldwide">
  <meta name="geo.placename" content="Worldwide">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RentMap',
    url: 'https://rentmap.net/',
    description,
    inLanguage: 'en'
  })}></script>
  
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #000;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }
  </style>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
