---
// src/layouts/Layout.astro
const { title = 'RentMap — Compare rental costs and plan your move', description = 'Compare rental cost snapshots, explore listing locations, and calculate a budget that includes bills and moving costs.', canonical = 'https://rentmap.net/', pageType = 'content', noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RentMap">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content="https://rentmap.net/favicon.svg">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  
  <!-- Geo meta (site is global) -->
  <meta name="geo.region" content="Worldwide">
  <meta name="geo.placename" content="Worldwide">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="google-adsense-account" content="ca-pub-3304804122762203">
  <!-- Ownership verification only. Ad execution stays disabled pending content and consent review. -->
  
  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'RentMap',
    url: 'https://rentmap.net/',
    description,
    inLanguage: 'en'
  })}></script>
  
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #000;
      color: #fff;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }
    body.city-layout { background:#f8faf7; color:#223d37; overflow:auto; height:auto; min-height:100vh; width:100%; }
    .city-layout .site-footer { border-top:1px solid #dfe7e1; color:#5f706b; background:#f8faf7; }
    .city-layout .site-footer a { color:#25634f; }
    .city-layout .site-footer a:focus-visible { outline:3px solid #277660; outline-offset:4px; }
    .site-footer {
      display:flex; justify-content:center; flex-wrap:wrap; gap:8px 14px;
      padding:22px 20px; color:#94a3b8; font-size:12px; line-height:1.5;
    }
    .site-footer a { color:#c4b5fd; text-decoration:none; }
    .site-footer a:hover { color:#fff; text-decoration:underline; }
    .globe-page .site-footer {
      position:fixed; left:50%; bottom:6px; transform:translateX(-50%); z-index:1600;
      width:max-content; max-width:calc(100vw - 24px); padding:5px 10px;
      border-radius:10px; background:rgba(10,14,23,.78); backdrop-filter:blur(8px);
    }
    @media (max-width: 768px) {
      .globe-page .site-footer { left:12px; bottom:7px; transform:none; justify-content:flex-start; gap:4px 10px; font-size:10px; }
    }
  </style>
  <slot name="head" />
</head>
<body class={pageType === 'globe' ? 'globe-page' : 'city-layout'}>
  <slot />
  <footer class="site-footer">
    <a href="/">RentMap</a>
    <a href="/rent-budget/">Budget calculator</a>
    <a href="/best-cities-for-remote-workers/">Rental guide</a>
    <a href="/explore/">Countries & guides</a>
    <a href="/about/">About & methodology</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <a href="mailto:kontakt@lejel.dk">Contact</a>
  </footer>
</body>
</html>
