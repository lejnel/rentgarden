    "db:init": "wrangler d1 execute rentradar-db --file=./schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/compiler": "^2.13.1",
    "astro": "^5.18.2",
    "cesium": "^1.125.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
